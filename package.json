{
  "name": "studyhub-ai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/tests/*.test.js",
    "register": "npm run build && node dist/scripts/deploy-commands.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "discord.js": "^14.0.0",
    "pino": "^9.0.0",
    "shoukaku": "^4.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
