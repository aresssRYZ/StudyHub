{
  "name": "studyhub-ai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/conversation.test.ts tests/focus.test.ts",
    "register": "node --import tsx scripts/deploy-commands.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "discord.js": "^14.0.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
